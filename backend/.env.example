# CallPilot v4.1 defaults: local transcription + Claude answers.
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=base.en

# Optional: only needed if you deliberately switch transcription to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Recommended answer provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: normally you connect Confluence from the app UI ("Connect
# Confluence"), which stores these in the local database instead. Set these
# only if you'd rather pre-configure it here (e.g. a headless deployment).
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# Only set this when deploying somewhere reachable beyond localhost (e.g. a
# hosted backend shared by a team). When set, every request must carry a
# matching "X-CallPilot-Key" header or gets a 401. Leave blank for local dev.
BACKEND_ACCESS_TOKEN=
