# CallPilot v4.1 defaults: local transcription + Claude answers.
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=base.en

# Optional: only needed if you deliberately switch transcription to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Recommended answer provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
